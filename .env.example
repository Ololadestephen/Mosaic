# Use a dedicated PostgreSQL database. Local setup writes .env.local, never Git.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
# Hosted Vercel previews derive this from VERCEL_URL when APP_ORIGIN is unset.
# Provision restricted synthetic test accounts before closing registration.
ALLOW_REGISTRATION=true
# Server-only Gemini Developer API. Never use NEXT_PUBLIC for provider secrets.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Combined answer/thinking ceiling. Application range 1024–65536; completion is not guaranteed.
# Thinking uses this model's supported MINIMAL level, not a numeric thinkingBudget.
GEMINI_MAX_OUTPUT_TOKENS=4096
# Confirm the key's project is Free tier with no billing before enabling calls.
GEMINI_FREE_TIER_CONFIRMED=false
# A locally assigned UUID identifies this authorized validation, across restarts/accounts.
GEMINI_VALIDATION_ID=
# Defaults to ten; raise only within an explicitly authorized cumulative allowance (maximum 13).
GEMINI_VALIDATION_CALL_LIMIT=10
# Legacy provider is available only when explicitly selected; never a fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AI_DAILY_CALL_LIMIT=10
AI_DAILY_BUDGET_USD=0
# Gemini free-only validation requires all three USD amounts to stay zero.
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
